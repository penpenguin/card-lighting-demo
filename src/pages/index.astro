---
const base = (import.meta.env.BASE_URL ?? "/").replace(/\/?$/, "/");
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Card Lighting Demo</title>
		<style>
			:root {
				--rx: 0deg;
				--ry: 0deg;
				--mx: 50%;
				--my: 50%;
				--posx: 50%;
				--posy: 50%;
				--tx: 0px;
				--ty: 0px;
				--s: 1;
				--hyp: 0.35;
				--light-strength: 1;
				color-scheme: dark;
			}

			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				min-height: 100vh;
				display: grid;
				place-items: center;
				font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				padding: clamp(16px, 4vw, 40px);
				overflow: hidden;
				background: radial-gradient(circle at 30% 20%, rgba(120, 130, 160, 0.18), transparent 26%),
					radial-gradient(circle at 80% 70%, rgba(40, 50, 70, 0.35), transparent 38%),
					#06070c;
				color: #e9ecf2;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			.stage {
				position: relative;
				width: min(1100px, 96vw);
				height: min(720px, 86vh);
				display: grid;
				place-items: center;
				perspective: 1100px;
				isolation: isolate;
				overflow: hidden;
			}

			.stage::before {
				content: "";
				position: absolute;
				inset: 0;
				background:
					radial-gradient(circle at var(--mx) var(--my), rgba(120, 140, 200, 0.24), transparent 42%),
					radial-gradient(120% 120% at 50% 50%, rgba(0, 0, 0, 0.35), transparent 68%);
				filter: blur(14px) brightness(calc(0.6 + 0.6 * var(--light-strength)));
				z-index: 0;
			}

			.stage::after {
				content: "";
				position: absolute;
				inset: -18%;
				background:
					radial-gradient(60% 55% at 50% 45%, rgba(255, 240, 220, 0.08), transparent 70%),
					radial-gradient(55% 50% at 50% 60%, rgba(120, 170, 255, 0.06), transparent 72%);
				filter: blur(22px);
				opacity: 0.85;
				pointer-events: none;
				z-index: 0;
			}

			.card {
				position: relative;
				width: 360px;
				height: 220px;
				--card-radius: 18px;
				border-radius: var(--card-radius);
				--chip-center-x: 17.6%;
				--chip-center-y: 44.3%;
				--pan-center-x: 11.9%;
				--pan-center-y: 60.7%;
				--pan-shine-bg:
					var(--chip-shine-bg,
						linear-gradient(120deg, rgba(255, 230, 190, 0.75), rgba(140, 210, 255, 0.7), rgba(255, 170, 230, 0.7))
					),
					linear-gradient(120deg, rgba(255, 210, 170, 0.35), rgba(120, 200, 255, 0.35), rgba(255, 160, 220, 0.35));
				--rim-glow-color-1: rgba(255, 255, 255, 0.95);
				--rim-glow-color-2: rgba(160, 210, 255, 0.7);
				--rim-glow-color-3: rgba(255, 255, 255, 0);
				--rim-glow-opacity: 0.24;
				--holo-texture-bg:
					repeating-linear-gradient(
						115deg,
						transparent 0 8px,
						rgba(255, 255, 255, 0.08) 9px,
						transparent 11px 18px
					);
				--holo-texture-size: 120% 120%;
				--holo-texture-position: var(--posx) var(--posy);
				--holo-texture-blend: screen;
				--holo-texture-opacity: calc(0.08 + 0.12 * var(--hyp));
				--holo-texture-filter: none;
				--surface-shine-bg:
					linear-gradient(115deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0)),
					radial-gradient(220px 150px at var(--mx) var(--my), rgba(255, 255, 255, 0.26), transparent 72%);
				--surface-shine-blend: screen;
				--surface-shine-filter: saturate(1.8) contrast(1.25) brightness(1.1);
				--surface-shine-opacity: calc(0.12 + 0.48 * var(--hyp));
				--surface-shine-size: 260% 260%, 180% 180%;
				--surface-shine-position:
					calc(100% - var(--posx)) calc(100% - var(--posy)),
					var(--mx) var(--my);
				--surface-shine-mask:
					linear-gradient(112deg, transparent 0 39%, #000 43%, #000 48%, transparent 53%),
					radial-gradient(220px 150px at var(--mx) var(--my), #000 0 32%, transparent 72%);
				--surface-shine-mask-size: 260% 260%, 100% 100%;
				--surface-shine-mask-position:
					calc(100% - var(--posx)) calc(100% - var(--posy)),
					var(--mx) var(--my);
				background: #0a0a0a;
				box-shadow:
					0 32px 80px rgba(0, 0, 0, 0.72),
					0 12px 26px rgba(0, 0, 0, 0.55),
					0 3px 8px rgba(0, 0, 0, 0.38);
				transform: translateZ(16px);
				transition: box-shadow 260ms ease, transform 200ms ease;
				overflow: visible;
				z-index: 1;
			}

			.card,
			.card__translater {
				transform-style: flat;
			}

			.card:hover {
				box-shadow:
					0 40px 86px rgba(0, 0, 0, 0.78),
					0 16px 34px rgba(0, 0, 0, 0.62),
					0 4px 10px rgba(0, 0, 0, 0.42);
			}

			.card__translater {
				position: absolute;
				inset: 0;
				transform: translate3d(var(--tx), var(--ty), 0) scale(var(--s));
				transition: transform 120ms ease;
			}

			.card__rotator {
				position: absolute;
				inset: 0;
				border-radius: var(--card-radius);
				transform: rotateY(var(--ry)) rotateX(var(--rx));
				transform-style: flat;
				overflow: hidden;
				isolation: isolate;
				clip-path: inset(0 round var(--card-radius));
				backface-visibility: hidden;
			}

			.layer {
				position: absolute;
				inset: 0;
				border-radius: inherit;
				pointer-events: none;
				transform: none;
				backface-visibility: hidden;
			}

			.layer-shadow {
				z-index: 0;
				background: radial-gradient(90% 120% at 50% 80%, rgba(0, 0, 0, 0.55), transparent 70%);
				filter: blur(10px);
				transform: none;
			}

			.layer-base {
				z-index: 1;
				background:
					radial-gradient(120% 90% at 22% 18%, rgba(92, 215, 255, 0.18), transparent 48%),
					radial-gradient(100% 90% at 76% 24%, rgba(255, 116, 230, 0.14), transparent 52%),
					radial-gradient(110% 95% at 54% 86%, rgba(255, 230, 128, 0.1), transparent 58%),
					linear-gradient(135deg, #0d1320 0%, #111827 42%, #151826 68%, #090d16 100%);
				transform: none;
			}

			.layer-holo {
				z-index: 2;
				background: var(--holo-texture-bg);
				background-size: var(--holo-texture-size);
				background-position: var(--holo-texture-position);
				mix-blend-mode: var(--holo-texture-blend, screen);
				opacity: var(--holo-texture-opacity);
				filter: var(--holo-texture-filter, none);
				transform: none;
			}

			.layer-glare {
				z-index: 3;
				background: var(--surface-shine-bg);
				background-size: 220% 220%, 100% 100%;
				background-position:
					calc(100% - var(--posx)) calc(100% - var(--posy)),
					var(--mx) var(--my);
				mix-blend-mode: var(--surface-shine-blend, screen);
				opacity: calc(0.02 + 0.12 * var(--hyp));
				filter: var(--surface-shine-filter);
				-webkit-mask-image: radial-gradient(190px 130px at var(--mx) var(--my), #000 0 28%, transparent 72%);
				mask-image: radial-gradient(190px 130px at var(--mx) var(--my), #000 0 28%, transparent 72%);
				transform: none;
			}

			.layer-sparkles {
				z-index: 5;
				background:
					radial-gradient(circle at 22% 18%, rgba(255, 255, 255, 0.98) 0 1.2px, transparent 2.8px),
					radial-gradient(circle at 73% 28%, rgba(140, 230, 255, 0.9) 0 1px, transparent 2.6px),
					radial-gradient(circle at 84% 72%, rgba(255, 180, 245, 0.86) 0 1.4px, transparent 3px),
					radial-gradient(circle at 39% 82%, rgba(255, 246, 156, 0.9) 0 1px, transparent 2.4px),
					radial-gradient(circle at 58% 46%, rgba(255, 255, 255, 0.72) 0 0.8px, transparent 2.2px);
				background-size: 105% 105%;
				background-position: var(--posx) var(--posy);
				background-repeat: no-repeat;
				mix-blend-mode: screen;
				opacity: calc(0.04 + 0.38 * var(--hyp));
				filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.82)) brightness(1.65);
				-webkit-mask-image: radial-gradient(180px 130px at var(--mx) var(--my), #000 0 42%, transparent 78%);
				mask-image: radial-gradient(180px 130px at var(--mx) var(--my), #000 0 42%, transparent 78%);
				transform: none;
				animation: sparkle-twinkle 900ms steps(2, end) infinite;
			}

			.layer-sparkles::after {
				content: "";
				position: absolute;
				inset: 0;
				border-radius: inherit;
				background:
					radial-gradient(circle at 13% 64%, rgba(255, 255, 255, 0.86) 0 0.9px, transparent 2px),
					radial-gradient(circle at 47% 21%, rgba(170, 225, 255, 0.78) 0 1px, transparent 2.6px),
					radial-gradient(circle at 67% 63%, rgba(255, 150, 238, 0.72) 0 0.9px, transparent 2.3px),
					radial-gradient(circle at 31% 38%, rgba(255, 245, 170, 0.74) 0 0.8px, transparent 2px);
				background-repeat: no-repeat;
				transform: none;
			}

			.layer-top-glare {
				z-index: 6;
				background: var(--surface-shine-bg);
				background-size: var(--surface-shine-size);
				background-position: var(--surface-shine-position);
				mix-blend-mode: var(--surface-shine-blend, screen);
				opacity: var(--surface-shine-opacity);
				filter: var(--surface-shine-filter);
				-webkit-mask-image: var(--surface-shine-mask);
				mask-image: var(--surface-shine-mask);
				-webkit-mask-size: var(--surface-shine-mask-size);
				mask-size: var(--surface-shine-mask-size);
				-webkit-mask-position: var(--surface-shine-mask-position);
				mask-position: var(--surface-shine-mask-position);
				transform: none;
			}

			@keyframes sparkle-twinkle {
				50% {
					opacity: calc(0.08 + 0.52 * var(--hyp));
					filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.9)) brightness(1.9);
				}
			}

			.chip,
			.number,
			.content {
				z-index: 4;
			}

			.layer-rim {
				inset: 0;
				border-radius: var(--card-radius);
				background: radial-gradient(90% 90% at var(--mx) var(--my),
					var(--rim-glow-color-1) 0%,
					var(--rim-glow-color-2) 32%,
					var(--rim-glow-color-3) 58%
				);
				z-index: 7;
				padding: 1px;
				-webkit-mask:
					linear-gradient(#000 0 0) content-box,
					linear-gradient(#000 0 0);
				-webkit-mask-composite: xor;
				mask:
					linear-gradient(#000 0 0) content-box,
					linear-gradient(#000 0 0);
				mask-composite: exclude;
				box-shadow: none;
				mix-blend-mode: screen;
				opacity: calc(var(--rim-glow-opacity, 0.24) + 0.6 * var(--hyp));
				filter: none;
				transform: none;
			}

			/* --- rare holo --- */
			.card[data-rarity="rare holo"] {
				--chip-shine-bg:
					repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.04) 6px, rgba(0, 0, 0, 0) 7px 16px),
					linear-gradient(120deg, rgba(255, 130, 220, 0.35), rgba(140, 200, 255, 0.45), rgba(255, 240, 170, 0.4)),
					radial-gradient(120px 90px at var(--mx) var(--my), rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0) 70%);
				--chip-shine-blend: soft-light, soft-light, screen;
				--chip-shine-filter: brightness(calc((var(--hyp) + 0.7) * 0.6)) contrast(2.2);
				--chip-shine-size: 220% 220%;
				--surface-shine-bg:
					repeating-linear-gradient(
						112deg,
						transparent 0 14px,
						rgba(130, 200, 255, 0.28) 15px,
						rgba(255, 244, 210, 0.2) 17px,
						transparent 24px
					),
					linear-gradient(120deg, rgba(255, 130, 220, 0.2), rgba(140, 200, 255, 0.28), rgba(255, 240, 170, 0.2));
				--surface-shine-mask:
					linear-gradient(112deg, transparent 0 30%, #000 42%, #000 56%, transparent 72%),
					radial-gradient(210px 140px at var(--mx) var(--my), #000 0 34%, transparent 74%);
				--surface-shine-filter: saturate(1.8) contrast(1.2) brightness(1.08);
				--surface-shine-opacity: calc(0.1 + 0.46 * var(--hyp));
				--rim-glow-color-1: rgba(255, 244, 210, 0.96);
				--rim-glow-color-2: rgba(130, 200, 255, 0.75);
				--rim-glow-opacity: 0.26;
			}




			/* --- rare holo galaxy --- */
			.card[data-rarity="rare holo galaxy"] {
				--chip-shine-bg:
					radial-gradient(120px 90px at calc(50% - (var(--mx) - 50%) * 2.2) calc(50% - (var(--my) - 50%) * 2.2), rgba(80, 140, 255, 0.4), transparent 70%),
					radial-gradient(120px 90px at var(--mx) var(--my), rgba(255, 255, 255, 0.4), transparent 70%),
					repeating-radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.9) 0 1px, transparent 1px 5px);
				--chip-shine-blend: color-dodge, screen, saturation;
				--chip-shine-filter: brightness(calc(0.5 + var(--hyp) * 0.35)) saturate(1.3);
				--chip-shine-size: 200% 200%;
				--holo-texture-bg:
					radial-gradient(circle at 18% 22%, rgba(255, 255, 255, 0.34) 0 1px, transparent 2.6px),
					radial-gradient(circle at 52% 34%, rgba(120, 190, 255, 0.24) 0 1.4px, transparent 3.2px),
					radial-gradient(circle at 78% 70%, rgba(255, 255, 255, 0.22) 0 1px, transparent 2.8px),
					repeating-radial-gradient(circle at 50% 50%, rgba(120, 190, 255, 0.08) 0 1px, transparent 1px 7px);
				--holo-texture-size: 130% 130%, 170% 170%, 150% 150%, 210% 210%;
				--holo-texture-position:
					var(--posx) var(--posy),
					calc(100% - var(--posx)) var(--posy),
					var(--posx) calc(100% - var(--posy)),
					var(--mx) var(--my);
				--holo-texture-opacity: calc(0.1 + 0.18 * var(--hyp));
				--surface-shine-bg:
					radial-gradient(circle at 20% 24%, rgba(255, 255, 255, 0.95) 0 1px, transparent 2px),
					radial-gradient(circle at 62% 38%, rgba(120, 190, 255, 0.8) 0 1.2px, transparent 3px),
					radial-gradient(circle at 76% 68%, rgba(255, 255, 255, 0.75) 0 1px, transparent 2.4px),
					radial-gradient(150px 110px at var(--mx) var(--my), rgba(90, 170, 255, 0.48), transparent 70%);
				--surface-shine-size: 120% 120%, 150% 150%, 180% 180%, 100% 100%;
				--surface-shine-position:
					var(--posx) var(--posy),
					calc(100% - var(--posx)) var(--posy),
					var(--posx) calc(100% - var(--posy)),
					var(--mx) var(--my);
				--surface-shine-mask:
					radial-gradient(240px 160px at var(--mx) var(--my), #000 0 42%, transparent 76%);
				--surface-shine-mask-size: 100% 100%;
				--surface-shine-mask-position: var(--mx) var(--my);
				--surface-shine-filter: saturate(1.8) contrast(1.4) brightness(1.16);
				--surface-shine-opacity: calc(0.12 + 0.5 * var(--hyp));
				--rim-glow-color-1: rgba(210, 240, 255, 0.96);
				--rim-glow-color-2: rgba(90, 170, 255, 0.7);
				--rim-glow-opacity: 0.28;
			}





			/* --- rare holo v --- */
			.card[data-rarity*="rare holo v"] {
				--chip-shine-bg:
					linear-gradient(90deg, rgba(255, 180, 255, 0.32), rgba(120, 220, 255, 0.34), rgba(255, 210, 150, 0.35)),
					repeating-linear-gradient(-60deg, rgba(0, 0, 0, 0.12) 0 8px, rgba(255, 255, 255, 0.05) 8px 12px),
					radial-gradient(120px 90px at var(--mx) var(--my), rgba(255, 255, 255, 0.3), rgba(0, 0, 0, 0));
				--chip-shine-blend: screen, hard-light, overlay;
				--chip-shine-filter: brightness(calc(0.55 + var(--hyp) * 0.4)) saturate(1.1);
				--chip-shine-size: 210% 210%;
				--holo-texture-bg:
					repeating-linear-gradient(
						96deg,
						transparent 0 7px,
						rgba(120, 220, 255, 0.16) 8px,
						rgba(255, 180, 255, 0.13) 9px,
						transparent 11px 18px
					),
					linear-gradient(90deg, rgba(255, 180, 255, 0.12), rgba(120, 220, 255, 0.14), rgba(255, 210, 150, 0.1));
				--holo-texture-size: 150% 150%, 220% 220%;
				--holo-texture-position:
					calc(100% - var(--posx)) var(--posy),
					var(--posx) var(--posy);
				--holo-texture-opacity: calc(0.08 + 0.18 * var(--hyp));
				--surface-shine-bg:
					repeating-linear-gradient(
						112deg,
						transparent 0 10px,
						rgba(120, 220, 255, 0.42) 11px,
						rgba(255, 180, 255, 0.34) 13px,
						transparent 18px
					),
					linear-gradient(90deg, rgba(255, 180, 255, 0.28), rgba(120, 220, 255, 0.32), rgba(255, 210, 150, 0.24));
				--surface-shine-mask:
					linear-gradient(112deg, transparent 0 25%, #000 38%, #000 58%, transparent 72%),
					radial-gradient(190px 130px at var(--mx) var(--my), #000 0 36%, transparent 74%);
				--surface-shine-filter: saturate(2.2) contrast(1.35) brightness(1.12);
				--surface-shine-opacity: calc(0.1 + 0.5 * var(--hyp));
				--rim-glow-color-1: rgba(245, 220, 255, 0.95);
				--rim-glow-color-2: rgba(110, 210, 255, 0.7);
				--rim-glow-opacity: 0.26;
			}



			/* --- rare holo vmax --- */
			.card[data-rarity="rare holo vmax"] {
				--chip-shine-bg:
					linear-gradient(135deg, rgba(255, 120, 200, 0.35), rgba(120, 220, 255, 0.35), rgba(240, 200, 255, 0.3)),
					repeating-linear-gradient(60deg, rgba(255, 255, 255, 0.1) 0 6px, rgba(0, 0, 0, 0) 6px 14px),
					radial-gradient(140px 110px at var(--mx) var(--my), rgba(255, 255, 255, 0.32), transparent 75%);
				--chip-shine-blend: color-burn, screen, soft-light;
				--chip-shine-filter: brightness(calc((var(--hyp) * 0.3) + 0.5));
				--chip-shine-size: 220% 220%;
				--holo-texture-bg:
					repeating-linear-gradient(
						58deg,
						rgba(255, 120, 200, 0.12) 0 5px,
						transparent 5px 17px
					),
					repeating-linear-gradient(
						122deg,
						transparent 0 10px,
						rgba(120, 230, 255, 0.18) 11px,
						rgba(240, 200, 255, 0.14) 14px,
						transparent 22px
					),
					radial-gradient(180px 130px at var(--mx) var(--my), rgba(255, 255, 255, 0.12), transparent 72%);
				--holo-texture-size: 160% 160%, 180% 180%, 100% 100%;
				--holo-texture-position:
					var(--posx) calc(100% - var(--posy)),
					calc(100% - var(--posx)) var(--posy),
					var(--mx) var(--my);
				--holo-texture-opacity: calc(0.12 + 0.22 * var(--hyp));
				--surface-shine-bg:
					repeating-linear-gradient(
						64deg,
						rgba(255, 120, 200, 0.18) 0 5px,
						transparent 5px 16px
					),
					repeating-linear-gradient(
						116deg,
						transparent 0 12px,
						rgba(120, 230, 255, 0.4) 13px,
						rgba(240, 200, 255, 0.3) 15px,
						transparent 24px
					);
				--surface-shine-mask:
					linear-gradient(116deg, transparent 0 20%, #000 36%, #000 64%, transparent 82%),
					radial-gradient(220px 150px at var(--mx) var(--my), #000 0 32%, transparent 72%);
				--surface-shine-filter: saturate(2.15) contrast(1.36) brightness(1.1);
				--surface-shine-opacity: calc(0.1 + 0.5 * var(--hyp));
				--rim-glow-color-1: rgba(255, 210, 250, 0.97);
				--rim-glow-color-2: rgba(120, 230, 255, 0.75);
				--rim-glow-opacity: 0.3;
			}


			/* --- rare holo vstar --- */
			.card[data-rarity="rare holo vstar"][data-supertype="pokemon"] {
				--chip-shine-bg:
					linear-gradient(120deg, rgba(255, 240, 210, 0.38), rgba(150, 210, 255, 0.34), rgba(255, 180, 220, 0.32)),
					repeating-linear-gradient(-45deg, rgba(0, 0, 0, 0.12) 0 10px, rgba(255, 255, 255, 0.04) 10px 18px),
					radial-gradient(140px 110px at var(--mx) var(--my), rgba(255, 255, 255, 0.26), transparent 72%);
				--chip-shine-blend: soft-light, hue, hard-light;
				--chip-shine-filter: brightness(calc(0.6 + var(--hyp) * 0.35));
				--chip-shine-size: 210% 210%;
				--holo-texture-bg:
					radial-gradient(circle at var(--mx) var(--my), rgba(255, 255, 255, 0.28) 0 2px, transparent 5px),
